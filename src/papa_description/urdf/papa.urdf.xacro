<?xml version="1.0"?>

<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro"
    name="cdr_mobile_robot">


    <!-- ================================================= -->
    <!-- PARÁMETROS GEOMÉTRICOS                            -->
    <!-- ================================================= -->

    <!-- STL exportados en centímetros: cm -> m -->
    <xacro:property name="mesh_scale" value="0.01"/>


    <!-- ================================================= -->
    <!-- BASE                                               -->
    <!-- ================================================= -->

    <!--
        CAD:
            X = 41.688 cm
            Y = 44.9812 cm
            Z = 1.0 cm

        Después de orientar el modelo según ROS:
            X = 44.9812 cm
            Y = 41.688 cm
    -->

    <xacro:property name="base_length" value="0.449812"/>
    <xacro:property name="base_width"  value="0.416880"/>
    <xacro:property name="base_height" value="0.010"/>

    <!-- Centro de la base respecto del eje de las ruedas -->
    <xacro:property name="base_z_from_axle" value="0.024788"/>


    <!-- ================================================= -->
    <!-- RUEDAS MOTRICES                                   -->
    <!-- ================================================= -->

    <!--
        Papa_RuedaGrande.stl:
            diámetro = 15.96 cm
            radio    = 7.98 cm
            ancho    = 3.00 cm
    -->

    <xacro:property name="wheel_radius" value="0.0798"/>
    <xacro:property name="wheel_width"  value="0.030"/>

    <!-- Distancia centro-centro: 42 cm -->
    <xacro:property name="wheel_separation" value="0.420"/>

    <!-- Posiciones medidas desde el ensamblaje FreeCAD -->
    <xacro:property name="left_wheel_y"  value="0.209812"/>
    <xacro:property name="right_wheel_y" value="-0.210188"/>

    <!-- Ambas ruedas están sobre el mismo eje longitudinal -->
    <xacro:property name="wheel_x" value="0.0"/>


    <!-- ================================================= -->
    <!-- RUEDA LIBRE                                       -->
    <!-- ================================================= -->

    <xacro:property name="caster_x" value="0.172381"/>
    <xacro:property name="caster_y" value="0.001108"/>
    <xacro:property name="caster_z" value="-0.029869"/>


    <!-- ================================================= -->
    <!-- LIDAR PROVISORIO                                  -->
    <!-- ================================================= -->

    <xacro:property name="lidar_radius" value="0.035"/>
    <xacro:property name="lidar_height" value="0.040"/>

    <!--
        Centro del cilindro.
        La superficie superior de la base está aproximadamente
        a z = 0.0298 m respecto de base_link.

        Con un LiDAR de 4 cm de alto:
            0.0298 + 0.020 ~= 0.05 m
    -->
    <xacro:property name="lidar_z" value="0.050"/>


    <!-- ================================================= -->
    <!-- COLORES                                           -->
    <!-- ================================================= -->

    <material name="base_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
    </material>

    <material name="wheel_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>

    <material name="caster_gray">
        <color rgba="0.65 0.65 0.65 1.0"/>
    </material>

    <material name="lidar_gray">
        <color rgba="0.15 0.15 0.15 1.0"/>
    </material>


    <!-- ================================================= -->
    <!-- BASE FOOTPRINT                                    -->
    <!-- ================================================= -->

    <!-- Frame ubicado sobre el suelo -->

    <link name="base_footprint"/>


    <!-- ================================================= -->
    <!-- BASE LINK                                         -->
    <!-- ================================================= -->

    <!--
        base_link está ubicado:

            X = centro del robot
            Y = centro del robot
            Z = altura del eje de las ruedas
    -->

    <link name="base_link">


        <!-- ================= VISUAL ================= -->

        <visual>

            <!--
                Papa_Base.stl:

                    X = [-20.844, 20.844] cm
                    Y = [-22.4906, 22.4906] cm
                    Z = [10, 11] cm

                Centro:
                    (0, 0, 10.5 cm)

                El eje de las ruedas está a:
                    Z = 8.0212 cm

                Se rota 90 grados alrededor de Z para
                adaptar el CAD a la orientación ROS.
            -->

            <origin
                xyz="0 0 -0.080212"
                rpy="0 0 ${pi/2}"/>

            <geometry>

                <mesh
                    filename="package://papa_description/meshes/Papa_Base.stl"
                    scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>

            </geometry>

            <material name="base_gray"/>

        </visual>


        <!-- ================= COLLISION ================= -->

        <collision>

            <origin
                xyz="0 0 ${base_z_from_axle}"
                rpy="0 0 0"/>

            <geometry>

                <box
                    size="${base_length} ${base_width} ${base_height}"/>

            </geometry>

        </collision>


        <!-- ================= INERTIAL ================= -->

        <!-- Valores provisionales -->

        <inertial>

            <origin
                xyz="0 0 ${base_z_from_axle}"
                rpy="0 0 0"/>

            <mass value="5.0"/>

            <inertia
                ixx="0.0417"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0708"
                iyz="0.0"
                izz="0.1042"/>

        </inertial>


    </link>


    <!-- ================================================= -->
    <!-- BASE FOOTPRINT -> BASE LINK                       -->
    <!-- ================================================= -->

    <joint name="base_footprint_joint" type="fixed">

        <parent link="base_footprint"/>
        <child link="base_link"/>

        <!-- Eje de las ruedas a un radio sobre el suelo -->

        <origin
            xyz="0 0 ${wheel_radius}"
            rpy="0 0 0"/>

    </joint>


    <!-- ================================================= -->
    <!-- RUEDA IZQUIERDA                                   -->
    <!-- ================================================= -->

    <link name="left_wheel_link">


        <!-- ================= VISUAL ================= -->

        <visual>

            <!--
                Centro original del STL:
                    (-54.0188, 0, 8.0212) cm

                Después de rotar +90 grados en Z:
                    (0, -54.0188, 8.0212)

                Se compensa para hacer coincidir el centro
                de la rueda con left_wheel_link.
            -->

            <origin
                xyz="0 0.540188 -0.080212"
                rpy="0 0 ${pi/2}"/>

            <geometry>

                <mesh
                    filename="package://papa_description/meshes/Papa_RuedaGrande.stl"
                    scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>

            </geometry>

            <material name="wheel_black"/>

        </visual>


        <!-- ================= COLLISION ================= -->

        <collision>

            <!-- Cilindro URDF: eje Z -> rotado hacia Y -->

            <origin
                xyz="0 0 0"
                rpy="${pi/2} 0 0"/>

            <geometry>

                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>

            </geometry>

        </collision>


        <!-- ================= INERTIAL ================= -->

        <inertial>

            <origin xyz="0 0 0" rpy="0 0 0"/>

            <mass value="0.30"/>

            <inertia
                ixx="0.00037"
                ixy="0.0"
                ixz="0.0"
                iyy="0.00063"
                iyz="0.0"
                izz="0.00037"/>

        </inertial>


    </link>


    <joint name="left_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="left_wheel_link"/>

        <origin
            xyz="${wheel_x} ${left_wheel_y} 0"
            rpy="0 0 0"/>

        <!-- Eje de rotación -->
        <axis xyz="0 1 0"/>

        <dynamics
            damping="0.0"
            friction="0.0"/>

    </joint>


    <!-- ================================================= -->
    <!-- RUEDA DERECHA                                     -->
    <!-- ================================================= -->

    <link name="right_wheel_link">


        <!-- ================= VISUAL ================= -->

        <visual>

            <!--
                Se usa el mismo STL que para la rueda izquierda.
                El joint define su posición en el lado opuesto.
            -->

            <origin
                xyz="0 0.540188 -0.080212"
                rpy="0 0 ${pi/2}"/>

            <geometry>

                <mesh
                    filename="package://papa_description/meshes/Papa_RuedaGrande.stl"
                    scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>

            </geometry>

            <material name="wheel_black"/>

        </visual>


        <!-- ================= COLLISION ================= -->

        <collision>

            <origin
                xyz="0 0 0"
                rpy="${pi/2} 0 0"/>

            <geometry>

                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>

            </geometry>

        </collision>


        <!-- ================= INERTIAL ================= -->

        <inertial>

            <origin xyz="0 0 0" rpy="0 0 0"/>

            <mass value="0.30"/>

            <inertia
                ixx="0.00037"
                ixy="0.0"
                ixz="0.0"
                iyy="0.00063"
                iyz="0.0"
                izz="0.00037"/>

        </inertial>


    </link>


    <joint name="right_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="right_wheel_link"/>

        <origin
            xyz="${wheel_x} ${right_wheel_y} 0"
            rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

        <dynamics
            damping="0.0"
            friction="0.0"/>

    </joint>


    <!-- ================================================= -->
    <!-- RUEDA LIBRE / CASTER                              -->
    <!-- ================================================= -->

    <link name="caster_link">


        <!-- ================= VISUAL ================= -->

        <visual>

            <!--
                Centro original Papa_RuedaChica:

                    (-74.8892, -17.2381, 5.0343) cm

                Después de rotar +90 grados en Z:

                    (17.2381, -74.8892, 5.0343) cm

                Se compensa el offset interno para colocar
                caster_link en el centro geométrico.
            -->

            <origin
                xyz="-0.172381 0.748892 -0.050343"
                rpy="0 0 ${pi/2}"/>

            <geometry>

                <mesh
                    filename="package://papa_description/meshes/Papa_RuedaChica.stl"
                    scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>

            </geometry>

            <material name="caster_gray"/>

        </visual>


        <!-- ================= COLLISION ================= -->

        <!-- Aproximación simple -->

        <collision>

            <origin xyz="0 0 0" rpy="0 0 0"/>

            <geometry>
                <sphere radius="0.045"/>
            </geometry>

        </collision>


        <!-- ================= INERTIAL ================= -->

        <inertial>

            <origin xyz="0 0 0" rpy="0 0 0"/>

            <mass value="0.10"/>

            <inertia
                ixx="0.000025"
                ixy="0.0"
                ixz="0.0"
                iyy="0.000025"
                iyz="0.0"
                izz="0.000025"/>

        </inertial>


    </link>


    <!-- ================================================= -->
    <!-- CASTER JOINT                                      -->
    <!-- ================================================= -->

    <joint name="caster_joint" type="fixed">

        <parent link="base_link"/>
        <child link="caster_link"/>

        <origin
            xyz="${caster_x} ${caster_y} ${caster_z}"
            rpy="0 0 0"/>

    </joint>


    <!-- ================================================= -->
    <!-- YDLIDAR X4                                        -->
    <!-- ================================================= -->

    <!--
        Por ahora usamos una geometría cilíndrica simple.

        El frame lidar_link representa aproximadamente
        el centro del sensor.

        Más adelante podemos reemplazar esta geometría
        por un STL del YDLIDAR si lo queremos.
    -->

    <link name="lidar_link">


        <!-- ================= VISUAL ================= -->

        <visual>

            <origin xyz="0 0 0" rpy="0 0 0"/>

            <geometry>

                <cylinder
                    radius="${lidar_radius}"
                    length="${lidar_height}"/>

            </geometry>

            <material name="lidar_gray"/>

        </visual>


        <!-- ================= COLLISION ================= -->

        <collision>

            <origin xyz="0 0 0" rpy="0 0 0"/>

            <geometry>

                <cylinder
                    radius="${lidar_radius}"
                    length="${lidar_height}"/>

            </geometry>

        </collision>


    </link>


    <!-- ================================================= -->
    <!-- LIDAR JOINT                                       -->
    <!-- ================================================= -->

    <joint name="lidar_joint" type="fixed">

        <parent link="base_link"/>
        <child link="lidar_link"/>

        <!--
            Posición provisoria:
                X = 0     -> centrado adelante/atrás
                Y = 0     -> centrado izquierda/derecha
                Z = 5 cm  -> apoyado sobre la plataforma
        -->

        <origin
            xyz="0 0 ${lidar_z}"
            rpy="0 0 0"/>

    </joint>


</robot>